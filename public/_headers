# Edge caching + security headers (read by Cloudflare Pages and Netlify).

# Hashed build assets never change — cache hard.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts.
*.woff2
  Cache-Control: public, max-age=31536000, immutable

# Pose images / brand art (stable, but not content-hashed).
/field/*
  Cache-Control: public, max-age=2592000
/brand-bg.jpg
  Cache-Control: public, max-age=2592000

# Instagram feed — refreshed every few hours.
/instagram.json
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

# HTML always revalidates so deploys go live immediately.
/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
